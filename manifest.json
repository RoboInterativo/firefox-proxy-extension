{
  "manifest_version": 2,
  "name": "Selective Proxy",
  "version": "1.0",
  "description": "Прокси для выборочных сайтов",
  "permissions": [
    "proxy",
    "storage",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png",
    "default_title": "Selective Proxy"
  },
  "icons": {
    "48": "icons/icon48.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "selective-proxy@example.com",
      "strict_min_version": "91.0"
    }
  }
}
